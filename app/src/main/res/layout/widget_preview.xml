<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview (Android 12+): the wide layout with placeholder content. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_widget_cover"
        android:tint="?android:attr/colorAccent" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:maxLines="1"
        android:text="@string/widget_label"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="14sp" />

    <ImageView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_widget_back_30"
        android:tint="?android:attr/textColorPrimary" />

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_widget_play"
        android:tint="?android:attr/colorAccent" />

    <ImageView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_widget_forward_30"
        android:tint="?android:attr/textColorPrimary" />
</LinearLayout>
